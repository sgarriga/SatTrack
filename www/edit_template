 <form action="/sat_save" method="post" id="edit_form">
  <input type="hidden" name="del_sat_row" value="{{ROW}}">
  <input type="hidden" name="sat_name" value="{{NAME}}">
  <table class="satform">
  <tr class="satform">
  <td colspan="3" class="satform">
  Satellite Name:&nbsp;{{NAME}}
  <br>
  <br>
  </td>
  </tr>
  <tr class="satform">
  <td class="satform">
  <label for="freq">Frequency (MHz):</label><br>
  <input type="number" id="freq" name="freq" value="{{FREQ}}" step="0.0001" style="width: 8em;">
  </td>
  <td class="satform">
  <label for="gain">Gain:</label><br>
  <input type="number" id="gain" name="gain" value="{{GAIN}}" style="width: 3em;"><br>
  <small>0 = Automatic</small>
  </td>
  <td class="satform">
  <label for="elev">Minimum Elevation (&deg;):</label><br>
  <input type="number" id="elev" name="elev" min="0" max="90" value="{{ELEV}}" step="5" style="width: 3em;"><br>
  <small>&deg; above horizon:</small>
  </td>
  </tr>

  <tr class="satform">
  <td class="satform">
  <fieldset>
    <legend>Signal Type</legend>
    <label><input type="radio" name="signal" value="APT" />APT</label><br>
    <label><input type="radio" name="signal" value="CW" />CW</label><br>
    <label><input type="radio" name="signal" value="LRPT" />LRPT</label><br>
    <label><input type="radio" name="signal" value="SSTV" />SSTV</label><br>
    <label><input type="radio" name="signal" value="VOX" />VOX</label> 
  </fieldset>
  </td>
  <td class="satform">
  <fieldset>
    <legend>RTL-SDR Device ID</legend>
    <label><input type="radio" name="dev" value="0" />0</label><br>
    <label><input type="radio" name="dev" value="1" />1</label> 
  </fieldset>
  </td>
  <td class="satform">
  <fieldset>
    <legend>Bias Tee</legend>
    <label><input type="radio" name="biast" value="OFF" />Off</label><br>
    <label><input type="radio" name="biast" value="GPIO1" />GPIO</label><br>
    <label><input type="radio" name="biast" value="USB" />USB</label> 
  </fieldset>
  </td>
  </tr>
  <tr class="satform">
  <td colspan="3" class="satform" style="text-align: right;">
  <input type="submit" value="Save" />
  </td>
  </tr>
  </table>
</form> 
